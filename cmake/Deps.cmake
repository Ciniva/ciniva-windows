set(DEPS_DIR "${CMAKE_BINARY_DIR}/_deps")

# Each of the semicolon-separated URLs is tried in order; all must serve the same file.
function(ciniva_fetch name urls sha256 out_file)
    list(GET urls 0 first)
    get_filename_component(file_name "${first}" NAME)
    set(dest "${DEPS_DIR}/${file_name}")
    if(NOT EXISTS "${dest}")
        set(errors "")
        foreach(url IN LISTS urls)
            message(STATUS "Downloading ${name} from ${url}")
            file(DOWNLOAD "${url}" "${dest}" TLS_VERIFY ON STATUS st)
            list(GET st 0 code)
            if(code EQUAL 0)
                file(SHA256 "${dest}" got)
                if(got STREQUAL sha256)
                    break()
                endif()
                set(st "hash mismatch ${got}")
            endif()
            file(REMOVE "${dest}")
            string(APPEND errors "\n  ${url}: ${st}")
        endforeach()
        if(NOT EXISTS "${dest}")
            message(FATAL_ERROR "Failed to download ${name}:${errors}")
        endif()
    endif()
    file(SHA256 "${dest}" actual)
    if(NOT actual STREQUAL sha256)
        file(REMOVE "${dest}")
        message(FATAL_ERROR "${name} hash mismatch: ${actual}")
    endif()
    set(${out_file} "${dest}" PARENT_SCOPE)
endfunction()

