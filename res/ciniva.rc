#include <winres.h>
#include "version.h"

1 ICON "ciniva.ico"

VS_VERSION_INFO VERSIONINFO
FILEFLAGSMASK 0x3fL
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Ciniva"
            VALUE "FileDescription", "Ciniva"
            VALUE "FileVersion", CINIVA_VERSION
            VALUE "ProductName", "Ciniva"
            VALUE "ProductVersion", CINIVA_VERSION
            VALUE "OriginalFilename", "ciniva.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
